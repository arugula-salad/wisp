# Userland for Daytona sandboxes: wisp's base image reshaped to look like the
# default sandbox Daytona's SDK documentation describes (user `daytona` with
# passwordless sudo, home and working directory /home/daytona, Python 3 with pip,
# Node.js with npm, TypeScript, git and the usual tools). There is no Daytona
# daemon in here: its toolbox API is served host-side by sandboxd's Daytona front
# end (frontend/daytona), on top of wisp-agent's exec and filesystem API. As with
# the base image there is no init system; the wisp-agent (booted from the
# initramfs) is PID 1. Build with `scripts/build-image.sh daytona`; see docs/images.md.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
# The E2B image's package set (images/e2b), kept identical so the two share layers.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash-completion build-essential ca-certificates curl dnsutils file gh git gnupg \
      iproute2 iputils-ping jq less locales lsof man-db nano netcat-openbsd openssh-client \
      procps psmisc python-is-python3 python3 python3-dev python3-pip python3-venv ripgrep \
      rsync socat sqlite3 sudo tmux tree unzip vim-tiny wget xz-utils zip \
    && rm -rf /var/lib/apt/lists/* \
    # Daytona's image has a python where `pip install` just works; Ubuntu's refuses
    # (PEP 668), which would break the most common first command in a sandbox.
    && rm -f /usr/lib/python3*/EXTERNALLY-MANAGED

ARG NODE_VERSION=22.23.3
RUN set -eu; cd /tmp; f="node-v$NODE_VERSION-linux-x64.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/$f"; \
    curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt" | grep " $f\$" | sha256sum -c -; \
    tar -xJf "$f" -C /usr/local --strip-components=1 --no-same-owner \
      --exclude CHANGELOG.md --exclude LICENSE --exclude README.md; \
    rm "$f"; corepack enable; node --version; npm --version

# TypeScript, for code_run in a sandbox whose language is typescript (tsx runs it).
RUN npm install -g --no-audit --no-fund typescript@5 tsx@4 ts-node@10 && npm cache clean --force

# Daytona's default user, at uid 1000. wisp-agent runs every command as the
# account named `sprite`, so `sprite` is the same account under a second name:
# the same uid, gid and home, listed after `daytona` so that whoami, ls -l and
# sudo all say daytona. Files the agent creates (uploads, new directories) are
# then daytona's, as they are on hosted Daytona.
RUN userdel -r ubuntu 2>/dev/null; \
    useradd -m -d /home/daytona -u 1000 -s /bin/bash -G sudo daytona && passwd -d daytona \
    && useradd -o -M -d /home/daytona -u 1000 -g daytona -s /bin/bash sprite \
    && echo 'daytona ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/daytona \
    && chmod 0440 /etc/sudoers.d/daytona \
    && chmod -R a+rwX /usr/local \
    && echo daytona > /etc/hostname
WORKDIR /home/daytona
