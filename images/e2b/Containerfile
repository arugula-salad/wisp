# Userland for E2B sandboxes: wisp's base image reshaped to look like E2B's `base`
# template (docker.io/e2bdev/base plus what E2B's template build adds: user `user`
# with passwordless sudo, a world-writable /usr/local and /code), with E2B's own
# envd daemon declared as a system service for wisp-agent to run. As with the base
# image there is no init system in here: the wisp-agent (booted from the
# initramfs) is PID 1. Build with `scripts/build-image.sh e2b`; see docs/images.md.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
# The base image's set, plus what e2bdev/base has that it lacks (gh, socat, which
# envd's port forwarder runs) and python-is-python3 (`python` exists there).
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash-completion build-essential ca-certificates curl dnsutils file gh git gnupg \
      iproute2 iputils-ping jq less locales lsof man-db nano netcat-openbsd openssh-client \
      procps psmisc python-is-python3 python3 python3-dev python3-pip python3-venv ripgrep \
      rsync socat sqlite3 sudo tmux tree unzip vim-tiny wget xz-utils zip \
    && rm -rf /var/lib/apt/lists/* \
    # e2bdev/base's python is python.org's, where `pip install` just works; Ubuntu's
    # refuses (PEP 668), which would break the most common first command in a sandbox.
    && rm -f /usr/lib/python3*/EXTERNALLY-MANAGED

# e2bdev/base ships Node 20, which is past end of life; 22 is the oldest supported LTS.
ARG NODE_VERSION=22.23.3
RUN set -eu; cd /tmp; f="node-v$NODE_VERSION-linux-x64.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/$f"; \
    curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt" | grep " $f\$" | sha256sum -c -; \
    tar -xJf "$f" -C /usr/local --strip-components=1 --no-same-owner \
      --exclude CHANGELOG.md --exclude LICENSE --exclude README.md; \
    rm "$f"; corepack enable; node --version; npm --version

# E2B's default user. ubuntu:24.04 ships an `ubuntu` account at uid 1000; E2B
# sandboxes have `user` there. wisp-agent's own exec sessions and services (the
# Sprites API, used for debugging these sandboxes) run as `sprite`, so it exists
# too, at the next uid, as it would on a disk made from any container image.
RUN userdel -r ubuntu 2>/dev/null; \
    useradd -m -u 1000 -s /bin/bash -G sudo user && passwd -d user \
    && echo 'user ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/user \
    && useradd -m -u 1001 -s /bin/bash sprite \
    && echo 'sprite ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/sprite \
    && chmod 0440 /etc/sudoers.d/user /etc/sudoers.d/sprite \
    && mkdir -p /code && chmod -R 777 /usr/local /code \
    && echo e2b > /etc/hostname

# envd, where E2B puts it, started at boot by wisp-agent (docs/images.md#system-services).
COPY --chmod=0755 envd /usr/bin/envd
COPY --chmod=0644 envd.json /etc/wisp/services.d/envd.json
